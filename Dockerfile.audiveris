# Audiveris(자바 OMR 엔진)를 소스에서 직접 빌드해 넣는 배포용 이미지.
# 이 이미지로 배포하면 서버가 Audiveris까지 갖추고 있어서, 로컬(사용자 PC)엔
# Java/Audiveris를 하나도 안 깔아도 웹 폼을 바로 쓸 수 있다.

FROM eclipse-temurin:25-jdk AS audiveris-build

RUN apt-get update && apt-get install -y --no-install-recommends git unzip \
    && rm -rf /var/lib/apt/lists/*

# javax.media:jai-core:1.1.3은 Maven Central에 없고, 원래 있던 JBoss 저장소는
# 접속이 막혀있는 경우가 흔하다(이 프로젝트 개발 중에도 그랬다). 벤더링해둔
# jar를 로컬 Maven 저장소에 직접 심어서 빌드가 외부 저장소 상태에 휘둘리지
# 않게 한다.
COPY vendor/jai-core-1.1.3.jar vendor/jai-core-1.1.3.pom /root/.m2/repository/javax/media/jai-core/1.1.3/

WORKDIR /build
RUN git clone --depth 1 https://github.com/Audiveris/audiveris audiveris
WORKDIR /build/audiveris
RUN ./gradlew build -x test --no-daemon
RUN mkdir -p /opt/audiveris \
    && unzip -q app/build/distributions/app-*.zip -d /opt/audiveris \
    && mv /opt/audiveris/app-* /opt/audiveris/dist


FROM eclipse-temurin:25-jre

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip poppler-utils fonts-nanum tesseract-ocr tesseract-ocr-eng libgtk-3-0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=audiveris-build /opt/audiveris/dist /opt/audiveris/dist
ENV AUDIVERIS_BIN=/opt/audiveris/dist/bin/Audiveris
ENV AUDIVERIS_JAVA_HOME=$JAVA_HOME
# print()가 파이프로 나갈 땐 버퍼링돼서 로그가 안 보이다가 한꺼번에 찍힘 —
# 처리 중 로그가 실시간으로 안 보여서 원인 파악이 안 되던 문제 해결.
ENV PYTHONUNBUFFERED=1
# 배포 서버엔 화면이 없다 — Swing 초기화가 그래도 GTK 네이티브 위젯을 찾아서
# libgtk-3.so가 없으면 (또는 있어도 디스플레이가 없으면) 죽는다. headless를
# 강제해서 애초에 그 경로를 안 타게 한다. (libgtk-3-0도 같이 깔아서 이중 방어.)
ENV JAVA_TOOL_OPTIONS=-Djava.awt.headless=true

# Audiveris는 실행 시 사용자 홈 아래 이 경로에서 OCR 언어 데이터를 찾는다.
RUN mkdir -p /root/.config/AudiverisLtd/audiveris/tessdata \
    && cp /usr/share/tesseract-ocr/*/tessdata/eng.traineddata \
          /usr/share/tesseract-ocr/*/tessdata/osd.traineddata \
          /root/.config/AudiverisLtd/audiveris/tessdata/

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir --break-system-packages -r requirements.txt

COPY . .

# gunicorn 기본 워커 타임아웃(30초)은 Audiveris 처리 시간(페이지당 20초+)보다
# 짧아서, 요청이 처리 중에 워커가 죽어 응답이 영영 안 오는 문제가 있었다.
CMD gunicorn -b 0.0.0.0:${PORT:-8080} --timeout 600 --workers 1 webapp:app
